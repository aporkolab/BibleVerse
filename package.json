{
  "name": "bibleverse",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:dev": "ng serve --configuration development --host 0.0.0.0 --port 4200",
    "start:prod": "npx serve -s dist/bibleverse -p 8080",
    "dev": "npm run start:dev",
    "serve": "npx serve -s dist/bibleverse",
    "watch": "ng build --watch --configuration=development",
    "build": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development",
    "build:development": "ng build --configuration=development",
    "build:staging": "ng build --configuration=staging",
    "build:production": "ng build --configuration=production",
    "build:analyze": "ng build --configuration=production --stats-json && echo 'Upload dist/bibleverse/stats.json to https://esbuild.github.io/analyze/'",
    "build:docker": "docker build -t bibleverse:latest .",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:watch": "ng test --watch=true",
    "test:ci": "ng test --watch=false --coverage",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:check": "ng lint --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "format:staged": "lint-staged",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:security": "npm audit --audit-level=moderate",
    "dependencies:check": "npm outdated",
    "dependencies:update": "npm update",
    "analyze": "npm run lint && npm run test:coverage",
    "docker:build": "docker build -t bibleverse:latest .",
    "docker:build:dev": "docker build -f Dockerfile.dev -t bibleverse:dev .",
    "docker:run": "docker run -p 8080:8080 bibleverse:latest",
    "docker:run:dev": "docker run -p 4200:4200 -v $(pwd):/app bibleverse:dev",
    "docker:compose": "docker-compose up",
    "docker:compose:dev": "docker-compose --profile development up",
    "docker:compose:down": "docker-compose down",
    "deploy:staging": "npm run build:staging && echo 'Deploy to staging'",
    "deploy:production": "npm run build:production && echo 'Deploy to production'",
    "k8s:deploy:staging": "kubectl apply -f k8s/staging/",
    "k8s:deploy:production": "kubectl apply -f k8s/production/",
    "clean": "rm -rf dist/ node_modules/.cache coverage/",
    "clean:all": "rm -rf dist/ node_modules/ coverage/ .angular/cache/",
    "clean:install": "npm run clean:all && npm install",
    "prebuild": "npm run clean",
    "ci:install": "npm ci --no-audit --no-fund",
    "ci:build": "npm run build:production",
    "ci:test": "npm run test:ci",
    "ci:lint": "npm run lint:check",
    "ci:security": "npm run audit:security",
    "ci:quality": "npm run ci:lint && npm run ci:test && npm run ci:security",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:patch": "npm run version:patch && git push --follow-tags",
    "release:minor": "npm run version:minor && git push --follow-tags",
    "release:major": "npm run version:major && git push --follow-tags"
  },
  "private": true,
  "homepage": "https://bibleverse.aporkolab.com",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
